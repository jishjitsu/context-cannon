{
  "name": "context-canon",
  "displayName": "context-canon",
  "description": "Zero-egress, AST-aware documentation RAG",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.109.0"
  },
  "enabledApiProposals": [
    "languageModelTools"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onChatParticipant:context-canon.agent",
    "onLanguageModelTool:canon_search"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "inputSchema": {
        "type": "object",
        "properties": {
            "query": {
                "type": "string",
                "description": "The search term to look up in the Django documentation index."
            }
        },
        "required": ["query"]
    },
    "chatParticipants": [
      {
        "id": "context-canon.agent",
        "fullName": "Context Canon",
        "name": "canon",
        "description": "Zero-egress AST-aware docs agent.",
        "isSticky": true
      }
    ],
    "languageModelTools": [
      {
        "name": "canon_search",
        "tags": [
          "docs",
          "code",
          "framework",
          "django"
        ],
        "displayName": "Context Canon Search",
        "modelDescription": "MANDATORY: Use this tool for ANY query regarding Django syntax, views, models, or configuration. You DO NOT have updated internal knowledge of this specific project's documentation. Always search first.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "canon",
        "icon": "$(search)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Syntax-heavy keywords to match against code blocks in the documentation."
            }
          },
          "required": [
            "query"
          ]
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "generate-docs": "npx tsx src/generate-docs.ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2",
    "node-loader": "^2.1.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "@xenova/transformers": "^2.17.2",
    "web-tree-sitter": "^0.26.5"
  }
}
